import <BASIC_OSC_PATH>
import <MAP_VERSION_OSC_PATH>

scenario sut_lane_change_for_stopped_vehicle_on_shoulder_scn_b23ee6071a05b6dd:
    map: Map
    map.set_map_file(map_version)
    ego_vehicle: Truck
    # road: highway, 2 lanes, ego starts rightmost
    shoulder_vehicle: Vehicle
    rear_vehicle: Vehicle
    do serial:
        initialization: parallel(duration: 2s):
            ego_vehicle.drive() with:
                position(at_point: geodetic_position_2d(latitude: <EGO_LAT> deg, longitude: <EGO_LON> deg), at: start, project_on_route: true)
                speed(20 mps, at: start)
            shoulder_vehicle.remain_stationary() with:
                position(60 m, ahead_of: ego_vehicle, at: start)
                # fully on right shoulder, inner-edge offset 0 m, width 2 m, shoulder 3.6 m
            rear_vehicle.drive() with:
                position(30 m, behind: ego_vehicle, at: start)
                speed(15 mps)
                lane(same_as: ego_vehicle, at: start)
        observation: parallel(duration: <OBSERVATION_S> s):
            # <ADS_CLOSED_LOOP_OBSERVATION_BINDING>
